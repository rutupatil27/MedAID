# OS / editors
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json

# Backend
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example
backend/coverage/
backend/logs/
backend/*.log
backend/secrets/

# Frontend (see frontend/.gitignore for Flutter specifics)
frontend/l10n_untranslated.json
