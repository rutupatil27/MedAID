# MedAID backend configuration — copy to .env and fill in real values.
# NEVER commit .env. Placeholders only in this file.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS (mobile apps send no Origin).
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind a reverse proxy/load balancer.
TRUST_PROXY=0

# ---- Database ---------------------------------------------------------------
# MongoDB Atlas (recommended) or a local replica set (transactions need one).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/medaid?retryWrites=true&w=majority

# ---- Authentication ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<replace-with-a-random-string-of-at-least-32-characters>
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# ---- First admin (used only by `npm run seed:admin`) ------------------------
ADMIN_SEED_NAME=MedAID Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=<choose-a-strong-password>

# ---- Cloudinary (volunteer documents; backend only) -------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medaid/volunteer-documents
MAX_UPLOAD_MB=5
DOCUMENT_URL_TTL_SECONDS=300

# ---- Routing (OpenRouteService; backend only) -------------------------------
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_PROFILE=foot-walking
ROUTING_TIMEOUT_MS=4000

# ---- Real hospitals from OpenStreetMap ---------------------------------------
# Tops up the hospitals collection from the public Overpass API around wherever
# people open the app, so the map is not limited to hand-entered places.
OSM_HOSPITAL_SYNC=true
# Comma-separated mirrors, tried in order.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OSM_TIMEOUT_MS=25000
OSM_CACHE_HOURS=24
OSM_MAX_RESULTS=150

# ---- Assignment engine ------------------------------------------------------
ASSIGNMENT_ACCEPT_TIMEOUT_SECONDS=120
ASSIGNMENT_EXPIRY_WARNING_SECONDS=30
LOCATION_STALE_SECONDS=300
ASSIGNMENT_SEARCH_RADIUS_METERS=5000
ASSIGNMENT_MAX_CANDIDATES=10
ASSIGNMENT_SCAN_INTERVAL_MS=10000
UNASSIGNED_RETRY_INTERVAL_MS=30000
ASSIGNMENT_ADMIN_ALERT_AFTER_ATTEMPTS=3
JOBS_ENABLED=true

# ---- Firebase Cloud Messaging (backend only) --------------------------------
# Path to the Firebase service-account JSON (keep it outside version control).
FCM_SERVICE_ACCOUNT_PATH=
